#!/bin/sh
# Lints the staged version of each server JavaScript file, so unstaged edits
# can't hide an error from the check.

cd "$(git rev-parse --show-toplevel)/server" || exit 1

eslint=node_modules/.bin/eslint
if [ ! -x "$eslint" ]; then
    echo "pre-commit: ESLint isn't installed, skipping lint (run npm install in server/)" >&2
    exit 0
fi

status=0
for file in $(git diff --cached --name-only --diff-filter=ACMR --relative -- '*.js' '*.cjs'); do
    git show ":./$file" | "$eslint" --no-warn-ignored --stdin --stdin-filename "$file" || status=1
done

if [ $status -ne 0 ]; then
    echo "pre-commit: fix the ESLint errors above, or skip the check with git commit --no-verify" >&2
fi
exit $status
