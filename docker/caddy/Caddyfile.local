# For trying the stack on a development machine: https://localhost with a certificate from
# Caddy's own CA, whose root is /data/caddy/pki/authorities/local/root.crt in the caddy_data
# volume. Nothing is asked of a public CA.
{
	local_certs
	skip_install_trust
	http_port {$POOL_HTTP_PORT}
}

localhost:{$POOL_HTTPS_PORT} {
	reverse_proxy web:80
}
