# Settings for docker compose. Secrets never go here: export POOL_JWT_SECRET and POOL_HE_DDNS_KEY
# in the shell that runs docker compose.

# the public name; the certificate is proved with the TXT record _acme-challenge.$POOL_HOSTNAME
POOL_HOSTNAME=pool.mystic.onthegrid.net
# the ACME account's contact, for recovering it
POOL_ACME_EMAIL=rhbroberg@yahoo.com
# Let's Encrypt; its staging CA, for trying a new setup without the rate limits, is
# https://acme-staging-v02.api.letsencrypt.org/directory
POOL_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# defaults, for reference
# POOL_HTTP_PORT=80
# POOL_HTTPS_PORT=443
# POOL_SERIAL_DEVICE=/dev/ttyUSB0
# POOL_MONGO_IMAGE=mongo:4.4.18
# POOL_MONGO_DATA=/data/db
