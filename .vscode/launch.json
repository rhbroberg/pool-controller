{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    // "outputCapture": "std" shows log4js output, which writes to stdout rather than console.log
    "version": "0.2.0",
    "configurations": [
    {
        "type": "node",
        "request": "launch",
        "name": "Tail dash-eff",
        "program": "${workspaceFolder}/server/server.js",
        "args": ["-f", "${workspaceFolder}/test-data/sample-various-bin", "-d", "tail", "--from-start"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Tail long capture",
        "program": "${workspaceFolder}/server/server.js",
        "args": ["-f", "${workspaceFolder}/test-data/sample-all-bin", "-d", "tail", "--from-start"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Simulated controller",
        "program": "${workspaceFolder}/server/server.js",
        "args": ["-f", "${workspaceFolder}/test-data/sample-various-bin", "-d", "sim"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Simulated controller (verbose)",
        "program": "${workspaceFolder}/server/server.js",
        "args": ["-f", "${workspaceFolder}/test-data/sample-various-bin", "-d", "sim", "-v"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Single File",
        "program": "${workspaceFolder}/server/server.js",
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "REST API tests",
        "cwd": "${workspaceFolder}/server",
        "runtimeArgs": ["--test", "--test-concurrency=1", "test/**/*.test.js"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "attach",
        "name": "Attach To Process",
        "port": 5858
    }]
}
