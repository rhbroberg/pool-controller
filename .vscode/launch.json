{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    // "outputCapture": "std" shows log4js output, which writes to stdout rather than console.log
    // runtimeArgs --import tsx loads TypeScript sources directly
    "version": "0.2.0",
    "configurations": [
    {
        "type": "node",
        "request": "launch",
        "name": "Tail dash-eff",
        "cwd": "${workspaceFolder}/server",
        "runtimeArgs": ["--import", "tsx"],
        "program": "${workspaceFolder}/server/server.ts",
        "args": ["-f", "${workspaceFolder}/server/test/test-data/sample-various-bin", "-d", "tail", "--from-start"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Tail long capture",
        "cwd": "${workspaceFolder}/server",
        "runtimeArgs": ["--import", "tsx"],
        "program": "${workspaceFolder}/server/server.ts",
        "args": ["-f", "${workspaceFolder}/server/test/test-data/sample-all-bin", "-d", "tail", "--from-start"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Simulated controller",
        "cwd": "${workspaceFolder}/server",
        "runtimeArgs": ["--import", "tsx"],
        "program": "${workspaceFolder}/server/server.ts",
        "args": ["-f", "${workspaceFolder}/server/test/test-data/sample-various-bin", "-d", "sim"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Simulated controller (verbose)",
        "cwd": "${workspaceFolder}/server",
        "runtimeArgs": ["--import", "tsx"],
        "program": "${workspaceFolder}/server/server.ts",
        "args": ["-f", "${workspaceFolder}/server/test/test-data/sample-various-bin", "-d", "sim", "-v"],
        "outputCapture": "std"
    },
    {
        // Mystic is mystic-backup-2026.11.08.tgz restored with --nsFrom 'Pool.*' --nsTo 'Mystic.*'
        "type": "node",
        "request": "launch",
        "name": "Simulated controller (Mystic production data)",
        "cwd": "${workspaceFolder}/server",
        "runtimeArgs": ["--import", "tsx"],
        "program": "${workspaceFolder}/server/server.ts",
        "args": ["-f", "${workspaceFolder}/server/test/test-data/sample-various-bin", "-d", "sim"],
        "env": { "MONGODB_URI": "mongodb://127.0.0.1:27017/Mystic" },
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Web front end (port 80)",
        "cwd": "${workspaceFolder}/web",
        "runtimeArgs": ["--import", "tsx"],
        "program": "${workspaceFolder}/web/server.ts",
        "env": { "PORT": "80", "POOL_API_URL": "http://localhost:3000" },
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Web front end (port 8080)",
        "cwd": "${workspaceFolder}/web",
        "runtimeArgs": ["--import", "tsx"],
        "program": "${workspaceFolder}/web/server.ts",
        "env": { "PORT": "8080", "POOL_API_URL": "http://localhost:3000" },
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "Single File",
        "cwd": "${workspaceFolder}/server",
        "runtimeArgs": ["--import", "tsx"],
        "program": "${workspaceFolder}/server/server.ts",
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "launch",
        "name": "REST API tests",
        "cwd": "${workspaceFolder}/server",
        "runtimeArgs": ["--import", "tsx", "--test", "--test-concurrency=1", "test/**/*.test.ts"],
        "outputCapture": "std"
    },
    {
        "type": "node",
        "request": "attach",
        "name": "Attach To Process",
        "port": 5858
    }]
}
