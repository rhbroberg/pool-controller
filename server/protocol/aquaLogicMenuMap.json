    "topLevelOrder": [
      "Settings Menu",
      "Timers Menu",
      "Diagnostic Menu",
      "Configuration Menu (Locked|Unlocked)",
      "Default Menu"
    ],
    "notes": [
      "Idle ~2 minutes returns to Default Menu and auto-scrolls its items.",
      "Blinking characters mark the editable field for +/-.",
      "Moving right/left after adjusting locks in the value.",
      "No persistent value changes were made during this capture; Configuration was unlocked temporarily for read-only inspection.",
      "Some unused Aux7\u201313 submenu trails may be incomplete due to occasional missed/doubled keypresses on RS-485; Name/Function were confirmed."
    ]
