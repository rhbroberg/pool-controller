{
    "name": "poolcontroller",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "node --test --test-concurrency=4 \"test/**/*.test.js\"",
        "coverage": "c8 node --test --test-concurrency=4 \"test/**/*.test.js\"",
        "replay": "node server.js",
        "test-realistic": "node server.js -f /tmp/in -d tail",
        "simulate": "node server.js -f ../test-data/sample-various-bin -d sim",
        "simulate-verbose": "node server.js -f ../test-data/sample-various-bin -d sim -v",
        "seed-history": "node tools/seed-history.js --days 30",
        "remove-seeded-history": "node tools/seed-history.js --remove",
        "find-servers": "node tools/find-servers.js",
        "start": "node server.js -d serial",
        "linter": "eslint .",
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "connect": "^3.6.6",
        "express": "^4.16.3",
        "js-yaml": "^3.12.0",
        "jsonwebtoken": "^9.0.0",
        "lodash": "^4.17.10",
        "log4js": "^6.9.1",
        "moment": "^2.22.2",
        "mongoose": "^8.24.8",
        "serialport": "^13.0.0",
        "socket.io": "^4.8.4",
        "swagger-tools": "^0.10.4",
        "yargs": "^12.0.1"
    },
    "devDependencies": {
        "c8": "^10.1.3",
        "eslint": "^9.39.5",
        "globals": "^17.14.0",
        "socket.io-client": "^4.8.4"
    }
