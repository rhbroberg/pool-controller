{
    "name": "poolcontroller",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "main": "server.ts",
    "scripts": {
        "test": "node --import tsx --test --test-concurrency=4 \"test/**/*.test.ts\"",
        "coverage": "c8 node --import tsx --test --test-concurrency=4 \"test/**/*.test.ts\"",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "replay": "tsx server.ts",
        "test-realistic": "tsx server.ts -f /tmp/in -d tail",
        "simulate": "tsx server.ts -f test/test-data/sample-various-bin -d sim",
        "simulate-verbose": "tsx server.ts -f test/test-data/sample-various-bin -d sim -v",
        "seed-history": "tsx tools/seed-history.ts --days 30",
        "remove-seeded-history": "tsx tools/seed-history.ts --remove",
        "rollup-history": "tsx tools/rollup-history.ts",
        "find-servers": "tsx tools/find-servers.ts",
        "start": "tsx server.ts -d serial",
        "linter": "eslint .",
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "express": "^4.16.3",
        "express-openapi-validator": "^5.6.2",
        "js-yaml": "^3.12.0",
        "jsonwebtoken": "^9.0.0",
        "lodash": "^4.17.10",
        "log4js": "^6.9.1",
        "moment": "^2.22.2",
        "mongoose": "^8.24.8",
        "openid-client": "^6.8.9",
        "serialport": "^13.0.0",
        "socket.io": "^4.8.4",
        "swagger-ui-express": "^5.0.1",
        "tsx": "^4.23.15",
        "yargs": "^17.7.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/express": "^5.0.6",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash": "^4.17.27",
        "@types/node": "^26.6.11",
        "@types/yargs": "^17.0.35",
        "@typescript-eslint/eslint-plugin": "^8.74.0",
        "@typescript-eslint/parser": "^8.74.0",
        "c8": "^10.1.3",
        "eslint": "^9.39.5",
        "globals": "^17.14.0",
        "socket.io-client": "^4.8.4",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "test-exclude": {
            "glob": "^14.0.4",
            "minimatch": "^11.0.5"
        }
    }
}
